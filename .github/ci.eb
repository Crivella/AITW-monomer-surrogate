easyblock = 'PythonBundle'

name = 'ci-aitw-infiltration-surrogate'
version = 'devel'
versionsuffix = '-%(software_commit)s'

homepage = 'https://www.ai-transpwood-project.eu/'
description = """AI-TranspWood - The code trains/use a multilayer perceptron to infer a mapping between the physical
parameters of the delignified transparent wood composites and their monomer infiltration saturation time.
"""

toolchain = {'name': 'foss', 'version': '2023a'}

builddependencies = [
    ('poetry', '1.7.1'),  # Needed to install textual
]

dependencies = [
    ('Python', '3.11.3'),
    ('SciPy-bundle', '2023.07'),
    ('PyTorch', '2.1.2'),
    ('scikit-learn', '1.3.1'),
]

exts_list = [
    ('textual', '0.61.0', {
        'checksums': ['91c83a659da40b227eced4fa749026a236b493cc5911a9bedd990ad5f0786be2'],
    }),
    ('trogon', '0.6.0', {
        'checksums': ['fd1abfeb7b15d79d6e6cfc9e724aad2a2728812e4713a744d975f133e7ec73a4'],
    }),
    (name, version, {
        'modulename': 'aitw_infiltration_surrogate',
        'source_urls': ['https://github.com/AI-TranspWood/AITW-infiltration-surrogate/archive/'],
        'sources': [{
            'download_filename': '%(software_commit)s.tar.gz',
            'filename': '%(software_commit)s.tar.gz',
        }],
        'testinstall': True,
        'runtest': 'pytest -sv --disable-warnings',
        'click_autocomplete_bins': ['aitw-infiltration-surrogate'],
    }),
]

sanity_check_commands = [
    'aitw-infiltration-surrogate --help',
]

moduleclass = 'chem'
